/dts-v1/;
#include <st/g4/stm32g474Xe.dtsi>
#include <st/g4/stm32g474r(b-c-e)tx-pinctrl.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
	model = "HT MAIN-01 STM32G474RE";
	compatible = "ht,ht-main";

	chosen {
		zephyr,console = &usart1;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
	};

	zephyr,user {
		oc-gpios = <&gpiod 2 GPIO_ACTIVE_LOW>;
		ov-gpios = <&gpiob 3 GPIO_ACTIVE_LOW>;
		sensor-gpios = <&gpiob 0 GPIO_ACTIVE_LOW>;
		coil-gpios = <&gpiob 15 GPIO_ACTIVE_LOW>;
		ac-gpios = <&gpiob 11 GPIO_ACTIVE_LOW>;
		dc-gpios = <&gpiob 12 GPIO_ACTIVE_LOW>;
		bat-gpios = <&gpiob 13 GPIO_ACTIVE_LOW>;
		charge-gpios = <&gpiob 14 GPIO_ACTIVE_LOW>;
		latch-gpios = <&gpiob 7 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>;
		buzzer-gpios = <&gpioa 12 GPIO_ACTIVE_HIGH>;
		wdi-gpios = <&gpiob 9 GPIO_ACTIVE_HIGH>;
	};
};

&clk_hse {
	clock-frequency = <DT_FREQ_M(8)>;
	status = "okay";
};

&pll {
	div-m = <2>;
	mul-n = <85>;
	div-p = <7>;
	div-q = <2>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(170)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <1>;
	apb2-prescaler = <1>;
};

&usart1 {
	pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/* Reserved for DWIN; enable after the screen baud rate and VP map are supplied. */
&usart3 {
	pinctrl-0 = <&usart3_tx_pc10 &usart3_rx_pc11>;
	pinctrl-names = "default";
	status = "disabled";
};

&i2c3 {
	pinctrl-0 = <&i2c3_scl_pc8 &i2c3_sda_pc9>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	status = "okay";

	relay_io: tca9539@74 {
		compatible = "ht,tca9539-safe";
		reg = <0x74>;
	};
};

/* The acquisition driver will own these resources in a later increment. */
&adc1 { status = "disabled"; };
&adc2 { status = "disabled"; };
&dac1 { status = "disabled"; };
&timers3 { status = "disabled"; };
&timers6 { status = "disabled"; };
&iwdg { status = "disabled"; };
