/* Rev23 rework: separate active-high logic inputs on a dual 12 V coil driver. */
/ {
	zephyr,user {
		/delete-property/ ac-gpios;
		/delete-property/ dc-gpios;
		/delete-property/ bat-gpios;
		/delete-property/ charge-gpios;
		ksafe-gpios = <&gpioc 4 GPIO_ACTIVE_HIGH>, <&gpioc 5 GPIO_ACTIVE_HIGH>;
	};
};
