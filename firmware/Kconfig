mainmenu "HT firmware"

choice HT_SCREEN_MODE
	prompt "Screen bring-up mode"
	optional

config HT_SCREEN_BRIDGE
	bool "Transparent USART1 to USART3 bridge"
	select HT_SCREEN_BRINGUP

config HT_SCREEN_PANEL
	bool "Display and front-panel bring-up"
	select HT_SCREEN_BRINGUP

endchoice

config HT_SCREEN_BRINGUP
	bool
	select UART_INTERRUPT_DRIVEN

config HT_SCREEN_TEMPERATURE
	bool "Sample three NTC channels during panel bring-up"
	depends on HT_SCREEN_PANEL
	help
	  Requires powered AVDD and the board's 22 kohm NTC pull-ups.
	  Owns ADC1 exclusively; the measurement acquisition path stays disabled.

config HT_DDS_BENCH
	bool "PA4-only DDS bench control"
	depends on HT_SCREEN_PANEL && HT_SCREEN_TEMPERATURE
	help
	  Requires the amplifier to be disconnected or unpowered. Explicit panel
	  or serial requests produce at most 100 mVpp for 60 seconds, with relays off.
	  No automatic start, output current control, or measurement acquisition.

source "Kconfig.zephyr"
